{:paths ["src"]

 ;; Deliberately does NOT depend on atlas core. A registry is a plain map, and
 ;; keeping this module free of it means any application can snapshot and track
 ;; its registry without pulling in the registry implementation itself.
 :deps
 {org.clojure/clojure   {:mvn/version "1.12.4"}
  org.clojure/data.json {:mvn/version "2.5.1"}}

 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps  {lambdaisland/kaocha {:mvn/version "1.87.1366"}}
         :main-opts   ["-m" "kaocha.runner"]}
  :build {:deps {io.github.clojure/tools.build {:git/tag "v0.9.6" :git/sha "8e78bcc"}}
          :ns-default build}}}
