{:paths ["bb" "core/src" "store/src" "review/src"]
 :deps {org.clojure/data.json {:mvn/version "2.4.0"}
        io.github.semantic-namespace/diff {:git/url "https://github.com/semantic-namespace/diff"
                                           :git/sha "fc5c5bd880a20a24103f8cf019b93c2b11e716ee"}}
 :tasks {source {:doc "The project's sources read from its files (EDN registry + annotated vars), no JVM and no code loaded; bb registry answers from the recorded store instead. bb source <where|uses|deps|data|check|summary> [arg] [--root dir] [--registry dir]... [--src dir]... [--json]. From another repo: bb --config <atlas-checkout>/bb.edn source ..."
                 :requires ([source-cli])
                 :task (apply source-cli/-main *command-line-args*)}
         source-smoke {:doc "Edits a copy of the cart example and checks atlas.source.index sees each edit"
                       :requires ([source-smoke])
                       :task (source-smoke/-main)}
         source-packs-smoke {:doc "Runs atlas.source.index with its packs (clojure.spec, malli, Pathom, a project's own) over the shop fixture, with and without the Pathom runtime snapshot"
                             :requires ([source-packs-smoke])
                             :task (source-packs-smoke/-main)}
         emacs-smoke {:doc "Runs atlas-source.el's batch tests against a real bb source serve: Flymake on the shop fixture, and eldoc/xref/describe on the cart example when clojure-mode is found. Needs Emacs 27+ ($EMACS)."
                      :requires ([emacs-smoke])
                      :task (emacs-smoke/-main)}
         pathom-snapshot-check {:doc "Rebuilds the shop fixture's Pathom snapshot from real Pathom 3 and 2 and checks it matches the committed one. Needs the clojure CLI."
                                :requires ([pathom-snapshot-check])
                                :task (pathom-snapshot-check/-main)}
         upgrade-check {:doc "Whether another atlas version changes what atlas does for a project: builds its registry with each version and diffs the registries and the atlas.llm-ide tools' answers. bb upgrade-check --build <qualified-fn|file.clj> [--project dir] [--from v] [--to v] [--paths p,...] [--probes file] [--out dir]; versions: current | mvn:<v> | local:<core path> | git:<sha>. From another repo: bb --config <atlas-checkout>/bb.edn upgrade-check ..."
                       :requires ([upgrade-check])
                       :task (apply upgrade-check/-main *command-line-args*)}
         upgrade-check-smoke {:doc "Runs upgrade-check on the cart example: same atlas identical, a patched atlas caught, a --probes file used. Needs the clojure CLI."
                              :requires ([upgrade-check-smoke])
                              :task (upgrade-check-smoke/-main)}
         invariants-smoke {:doc "Runs atlas's function and DSL invariants in bb, with no Datascript, on the cart and pet-shop examples"
                           :requires ([invariants-smoke])
                           :task (invariants-smoke/-main)}
         bb-compat {:doc "Every namespace under core, store and review loads in bb, except those in bb/jvm-only.edn"
                    :requires ([bb-compat])
                    :task (bb-compat/-main)}
         registry {:doc "Registry questions from a git store checkout, no JVM. bb registry <command> <store-dir> [args] [--prefix p] [--json]. Commands: diff <old-ref> <new-ref>; timeline <from-ref> <to-ref> [dev-id]; provenance <dev-id> [--from ref] [--to ref]; blast-radius|trace-causes <ref> <dev-id>... [--hops n]; producers-of|consumers-of <ref> <data-key>; dependents|dependencies <ref> <dev-id>; gaps <ref> [--min-similarity x] [--max n]; review analyses: overview, by-aspect, entities-by-type, entity-detail, entity-position, consumer-pattern, near-intent, suggest-placement, aspect-anomalies, aspect-signature, aspect-lifecycle, bottlenecks, islands, orphans (run with no command for their arguments). From another repo: bb --config <atlas-checkout>/bb.edn registry ..."
                   :requires ([atlas.review.cli :as cli])
                   :task (apply cli/-main *command-line-args*)}
         store-cli-smoke {:doc "Builds a throwaway git store from test/app examples and runs every registry command against it"
                          :requires ([store-cli-smoke])
                          :task (store-cli-smoke/-main)}}}
