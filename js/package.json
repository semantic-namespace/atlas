{
  "name": "@semantic-namespace/atlas",
  "version": "0.1.3-alpha",
  "description": "Atlas semantic registry for JavaScript \u2014 query, analyze, and reason about software architecture",
  "type": "module",
  "main": "dist/atlas.js",
  "module": "dist/atlas.js",
  "exports": {
    ".": "./dist/atlas.js",
    "./slim": "./dist-slim/atlas.js",
    "./meta-source/endpoint-call": "./meta-source/endpoint-call.cjs"
  },
  "files": [
    "dist/",
    "dist-slim/",
    "meta-source/"
  ],
  "scripts": {
    "build": "npx shadow-cljs release atlas-js",
    "build:slim": "npx shadow-cljs release atlas-js-slim",
    "build:all": "npx shadow-cljs release atlas-js atlas-js-slim",
    "dev": "npx shadow-cljs watch atlas-js-dev",
    "dev:slim": "npx shadow-cljs watch atlas-js-slim-dev",
    "clean": "rm -rf dist dist-dev dist-slim dist-slim-dev",
    "test": "node test/smoke.mjs",
    "test:pack": "node --test test/*.test.cjs"
  },
  "keywords": [
    "atlas",
    "semantic",
    "registry",
    "architecture",
    "ontology"
  ],
  "license": "MIT",
  "devDependencies": {
    "shadow-cljs": "^2.27.5",
    "js-qualified-keywords": "^0.1.1",
    "meta-source": "github:semantic-namespace/meta-source#b08abe10939407a13a35652fc539cb7151214583"
  }
}
