{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        io.github.semantic-namespace/atlas {:local/root "../core"}
        io.github.semantic-namespace/atlas-store {:local/root "../store"}
        io.github.semantic-namespace/diff {:git/url "https://github.com/semantic-namespace/diff"
                                          :git/sha "f5af5205c8de209aed75c615a6a9289aa11923c5"}}
 :aliases {:serve {:main-opts ["-m" "atlas.review.server"]}
           :test {:extra-paths ["test"]
                  :main-opts ["-e" "(require 'atlas.review.diff-test 'atlas.review.risk-test 'atlas.review.group-test 'atlas.review.reach-test 'atlas.review.deps-bridge-test 'atlas.review.ownership-test 'atlas.review.registry-test) (let [{:keys [fail error]} (clojure.test/run-tests 'atlas.review.diff-test 'atlas.review.risk-test 'atlas.review.group-test 'atlas.review.reach-test 'atlas.review.deps-bridge-test 'atlas.review.ownership-test 'atlas.review.registry-test)] (System/exit (if (pos? (+ fail error)) 1 0)))"]}}}
